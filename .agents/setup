#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
node_version="22.18.0"
qmd_version="2.5.3"

node_major="$(node --version 2>/dev/null | sed -E 's/^v([0-9]+).*/\1/' || true)"
if [[ -z "$node_major" || "$node_major" -lt 22 ]]; then
  case "$(uname -m)" in
    x86_64) node_arch="x64" ;;
    aarch64) node_arch="arm64" ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac

  echo "Installing Node.js ${node_version}..."
  archive="$(mktemp --suffix=.tar.xz)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://nodejs.org/dist/v${node_version}/node-v${node_version}-linux-${node_arch}.tar.xz" -o "$archive"
  sudo tar -xJf "$archive" --strip-components=1 -C /usr/local
  rm -f "$archive"
  trap - EXIT
  hash -r
fi

echo "Installing qmd ${qmd_version}..."
if ! command -v qmd >/dev/null 2>&1 || [[ "$(qmd --version)" != "qmd ${qmd_version}" ]]; then
  sudo npm install --global "@tobilu/qmd@${qmd_version}"
fi

echo "Configuring the xbm qmd collection..."
collection="$(qmd collection show xbm 2>/dev/null || true)"
if [[ -n "$collection" ]] && ! grep -Fq "Path:     $repo_root" <<<"$collection"; then
  qmd collection remove xbm
  collection=""
fi
if [[ -z "$collection" ]]; then
  qmd collection add "$repo_root" --name xbm --mask "**/*.md"
fi

echo "Refreshing the qmd index..."
qmd update
qmd embed

echo "Orb setup complete."
